# Copy to .env.local for development. Never commit .env.local.
# In production these are set in Netlify's environment variables (P2-005).

# P2-007 — the EXISTING Supabase project, shared with the trading desk.
# New tables only. Nothing existing is altered.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# P2-304/P2-305 — ALATPay. Virtual-account API, not the popup SDK.
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
ALATPAY_WEBHOOK_SECRET=

# P2-306/P2-307 — USDT TRC-20. The xpub only; the seed never reaches this app.
TRON_WATCH_XPUB=
TRON_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
