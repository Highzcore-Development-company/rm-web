# Copy to .env.local for development. Never commit .env.local.
# In production these are set in Netlify's environment variables (P2-005).
#
# TWO SUPABASE PROJECTS.
#   rm-web    — this app owns it. Users, investors, subscriptions, invoices.
#   rm-server — the bot owns it. Equity snapshots, trades, live positions.
#               WE ONLY EVER READ FROM IT. Nothing here writes to rm-server.

# ---------------------------------------------------------------------------
# rm-web — ours
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never give this a NEXT_PUBLIC_ prefix, never
# paste it into chat or a ticket, and never import it from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# rm-server — the bot's, read-only
# ---------------------------------------------------------------------------
# Deliberately NOT NEXT_PUBLIC_: the performance page renders on the server,
# so the browser never needs these. Keeping them server-only means a mistake in
# a client component fails to compile rather than shipping a key to every
# visitor.
RM_SERVER_SUPABASE_URL=
# The ANON key, not the service role. We read published figures; if a read
# needs more than the anon key can see, the fix is a policy on rm-server, not a
# more powerful key over here.
RM_SERVER_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Vantage (P2-201/202/206) — none of these are secret
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VANTAGE_PARTNER_LINK=
NEXT_PUBLIC_VANTAGE_MANAGER_ID=
NEXT_PUBLIC_VANTAGE_MINIMUM_USD=200
NEXT_PUBLIC_RECOMMENDED_MINIMUM_USD=1000

# Days after expiry before an investor is flagged for MAM detachment (P2-311).
NEXT_PUBLIC_GRACE_PERIOD_DAYS=3

# ---------------------------------------------------------------------------
# P2-304/305 — ALATPay. Virtual-account API, not the popup SDK.
# ---------------------------------------------------------------------------
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
ALATPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# P2-306/307 — USDT TRC-20. The account-level PUBLIC xpub only.
# The seed never belongs in this application's environment.
# ---------------------------------------------------------------------------
TRON_WATCH_XPUB=
TRON_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3002
