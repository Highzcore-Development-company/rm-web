# Copy to .env.local and fill in. Never commit .env.local.
#
# Anything prefixed NEXT_PUBLIC_ is INLINED INTO THE BROWSER BUNDLE and handed
# to every visitor. Only put a value there if you would be happy printing it on
# the homepage. Everything else stays server-side.
#
# Mirror these into Netlify when deploying (P2-005), keeping the same split.

# ===========================================================================
# rm-web — our Supabase project. Users, investors, subscriptions, invoices.
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses RLS entirely. Server-only. Never paste into chat, a ticket, or a
# NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=

# ===========================================================================
# rm-server — the bot's project.
#
# Read-only with the anon key below. No NEXT_PUBLIC_ prefix on purpose: the
# performance page renders on the server, so importing these from a client
# component fails the build rather than shipping a key to every visitor.
# ===========================================================================
RM_SERVER_SUPABASE_URL=
RM_SERVER_SUPABASE_ANON_KEY=

# The ONE exception to read-only: the admin bot page (A8) changes lot size,
# profit target, per-market enable and the global trading switch. The bot
# grants those to `authenticated` on ITS project, and an rm-web session means
# nothing there — two Supabase projects, two auth systems. So the panel signs
# in as one dedicated rm-server account.
#
# Create it in rm-server's own auth, with a long random password, and use it
# for nothing else. NOT rm-server's service-role key: this account can only
# reach what the bot chose to grant, where the service key could rewrite the
# bot's whole database if anything here went wrong.
#
# Leave blank and the bot page is read-only and says so. That is the correct
# state until the bot's schema is actually on rm-server.
RM_SERVER_OPERATOR_EMAIL=
RM_SERVER_OPERATOR_PASSWORD=

# ===========================================================================
# ALATPay — bank transfer and card (P2-304, P2-305)
#
# SERVER-ONLY. The company site's integration is the browser SDK so its key is
# public by necessity; ours is not, and must never gain a NEXT_PUBLIC_ prefix.
# ===========================================================================
ALATPAY_API_KEY=
ALATPAY_BUSINESS_ID=
# Set if ALATPay signs its callbacks, so we can reject forged ones.
ALATPAY_WEBHOOK_SECRET=
# Override to point at their sandbox.
ALATPAY_API_BASE=

# ===========================================================================
# USDT TRC-20 (P2-306, P2-307)
#
# The ACCOUNT-LEVEL PUBLIC xpub only — never a seed phrase or private key.
# Verified: this one is xpub, public-only, depth 3. Correct.
#
# Shares MYPOKER's wallet on a different branch: MYPOKER derives at /5/<index>,
# we derive at /7/<index>. Same seed, separate address space, no collisions.
#
# >>> THIS IS NILE TESTNET, NOT MAINNET. <<<
# It takes no real money, which is exactly what we want while building. Before
# launch, all three of these change together:
#   TRON_API_URL         -> https://api.trongrid.io
#   USDT_TRC20_CONTRACT  -> TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
#   DEPOSIT_CONFIRMATIONS-> 20
# Changing one without the others is worse than changing none: mainnet money
# credited after one confirmation, or real transfers watched on a testnet node.
# ===========================================================================
TRON_WATCH_XPUB=
TRON_API_URL=
# TronGrid works unauthenticated at a low rate limit; a key raises it.
TRON_API_KEY=
USDT_TRC20_CONTRACT=
DEPOSIT_CONFIRMATIONS=1
DEPOSIT_POLL_MS=15000

# ===========================================================================
# Email — Supabase sends auth mail via its own SMTP settings, not these.
# These are for the app's own mail: renewal reminders and receipts (P2-310).
# ===========================================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# Quoted: unquoted spaces break anything that sources this file, and a From
# header needs the angle brackets.
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_ADMIN=

# ===========================================================================
# Vantage (P2-201, P2-202, P2-206) — none of these are secret, so they are
# NEXT_PUBLIC_ deliberately. The partner link and manager ID are published to
# investors by design.
#
# PARTNER LINK IS EMPTY = COMMISSION LEAK. With it blank the "Open a Vantage
# account" button falls through to Vantage's homepage and the signup is not
# attributed to us. Nothing looks broken; the commission simply never arrives.
# ===========================================================================
NEXT_PUBLIC_VANTAGE_PARTNER_LINK=
NEXT_PUBLIC_VANTAGE_MANAGER_ID=
# Vantage's own minimum, and ours. Both currently guesses shown to investors.
NEXT_PUBLIC_VANTAGE_MINIMUM_USD=200
NEXT_PUBLIC_RECOMMENDED_MINIMUM_USD=1000

# ===========================================================================
# App settings
# ===========================================================================
# Days after expiry before an investor is flagged for MAM detachment (P2-311).
NEXT_PUBLIC_GRACE_PERIOD_DAYS=3
# Calls per minute per API key (P2-605).
API_RATE_LIMIT_PER_MINUTE=60
# Keep /api/v1/signals closed until D4 decides the free/paid split (P2-604).
API_SIGNALS_ENABLED=false
# Shared secret for the two /api/jobs/* endpoints. They answer 403 until it is
# set (see src/lib/job-auth.ts).
CRON_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
